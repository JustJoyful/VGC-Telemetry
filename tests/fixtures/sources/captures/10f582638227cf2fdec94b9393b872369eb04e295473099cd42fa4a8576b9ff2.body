<script src="/static/js/featherlight.min.js" type="text/javascript" charset="utf-8"></script>
<script>
function imgError(image) {
    image.onerror = "";
    image.src = "https://storage.googleapis.com/files.rk9labs.com/sprites/broadcast/000_000.png";
    return true
}

$(document).ready(function() {
    $("button.translate").on('click', function() {
        var lang = $(this).text();
        $("div.translation").hide();
        $("button.translate").removeClass('btn-warning');
        $(".translation.lang-" + lang).show();
        $(this).addClass('btn-warning');
    });
    
    
    
    $("button.translate#button-EN").click();
    
    
    $.featherlight.defaults.closeOnClick = 'anywhere';
});
</script>


