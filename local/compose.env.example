# Copy to .env.local; dummy local credentials only. Do not add AWS credentials.
VGC_LOCAL_DEMO=true
VGC_LOCAL_CONTAINER=true
AWS_ACCESS_KEY_ID=localdemo
AWS_SECRET_ACCESS_KEY=local-demo-secret
AWS_DEFAULT_REGION=us-east-1
AWS_EC2_METADATA_DISABLED=true
DYNAMODB_TABLE_NAME=vgc-telemetry-demo
S3_RAW_BUCKET_NAME=vgc-telemetry-demo
DYNAMODB_ENDPOINT_URL=http://dynamodb:8000
S3_ENDPOINT_URL=http://storage:9000
# Replace before any opt-in public access. This demo secret is only for local cursors.
V2_CURSOR_SECRET=local-demo-cursor-secret-32-bytes-minimum
CATALOG_RUNTIME_ENABLED=false
LOCAL_SCHEDULES_ENABLED=false
